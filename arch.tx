// Metamodel (M2) of the architecture description language for the SoS.
// Starting point: language of Laboratory 4. Adaptations of team D are marked [D];
// adaptations of team A (Caribbean Port, CPMS) are marked [A]; adaptations of
// team C (Road Transportation, RTS) are marked [C]. Every [A] and [C] change is an
// addition: the models written for [D] and [A] keep their meaning.
// Delivery 4: the elements of Laboratory 5 for verification (capacity, store, and
// scenarios with workloads, faults, varied parameters and measures) are marked [L5];
// scenarios with their six parts and tactics as elements are marked [D4]. Every
// addition is optional, so the models of Delivery 3 keep conforming.
Model:
  'system' name=ID
  constituents+=Constituent
  elements+=Element
  analyses*=Analysis
  scenarios*=Scenario                       // [L5, D4]
  tactics*=Tactic                           // [D4]
;

Constituent:
  'constituent' name=ID label=STRING 'owner' owner=STRING
;

Element:
  Component | Connector
;

Component:
  'component' name=Ident label=STRING       // [A] Ident (see below)
  'in' system=[Constituent]
  'tier' tier=Tier
  'kind' kind=Kind
  ('domain' domain=ID)?                     // [D] owner domain inside the constituent (C4)
  ('availability' availability=NUMBER)?
  ('latency' latency=NUMBER)?
  ('event_capacity' event_capacity=NUMBER)? // [D, C] events/s one instance can consume or drain
  ('event_load' event_load=NUMBER)?         // [D, C] events/s received in the peak
  ('instances' instances=INT)?              // [D] active instances (default 1)
  ('period' period=NUMBER)?                 // [C] period of periodic publication (ms)
  ('misses' misses=NUMBER)?                 // [C] missed periods before detection
  ('buffer' buffer=NUMBER)?                 // [C] retention capacity (events)
  ('capacity' capacity=NUMBER)?             // [L5] service rate of one instance (requests or events/s)
  (store?='store')?                         // [L5] holds the jobs while the next component is down
;

Connector:
  'connector' name=Ident                    // [A] Ident (see below)
  'nature' natures+=Nature[',']
  'coupling' coupling=Coupling
  'carries' info=STRING
  ('agreement' agreement=STRING)?
  ('availability' availability=NUMBER)?
  ('latency' latency=NUMBER)?
  ('event_capacity' event_capacity=NUMBER)? // [A, C] requests or events/s the connector admits or drains
  ('event_load' event_load=NUMBER)?         // [A, C] requests or events/s it carries in the peak
  ('period' period=NUMBER)?                 // [C] period of periodic publication (ms)
  ('misses' misses=NUMBER)?                 // [C] missed periods before detection
  ('buffer' buffer=NUMBER)?                 // [C] retention capacity (events)
  ':' links+=Link[',']
;

Link:
  path+=[Component|Ident]['->']
;

Analysis:
  'analysis' name=ID 'scenario' scenario=STRING
  metric=Metric
  ('backlog' backlog=NUMBER)?               // [D] events to absorb (recovery)
  'target' target=NUMBER
  ('outage' outage=NUMBER)?                 // [C] outage duration in seconds (drain)
  ('mttr' mttr=NUMBER)?                     // [D4] mean time to repair (h) for the simulation of availability
  ':'
  factors+=Factor[',']
;

Factor:
  Group | Single
;

// [D] A factor may carry its own budget for the analysis (= value) and, for a
// component with several instances, the common-cause fraction of its replicas.
// [A] 'replicas n' evaluates the element as n replicas without changing its instances
// (a hypothetical structure, e.g. the 'before' of Delivery 2 for the CPMS).
Single:
  ref=[Element|Ident] ('=' value=NUMBER)? ('replicas' replicas=INT)? ('beta' beta=NUMBER)?
;

// [D] In availability, a group is a set of replicas with fraction beta (Lab 4).
// In deadline, latency and detection, a group is a set of parties that work in parallel (the maximum counts).
Group:
  '[' members+=Single['|'] ']' ('beta' beta=NUMBER)?
;

// [L5] A scenario for simulation, extended in [D4] with the six parts of a quality
// scenario. The artifact refers to elements of the model. A scenario that the model
// cannot simulate keeps its six parts and is either verified by an analysis of the
// model or declared not verifiable, with the concept or technique that is missing.
Scenario:
  'scenario' name=ID label=STRING
  ('attribute' attribute=STRING)?                                 // [D4]
  ('source' source=STRING)?                                     // [D4]
  ('stimulus' stimulus=STRING)?                                 // [D4]
  ('artifact' artifact+=[Element|Ident][','])?                  // [D4]
  ('environment' environment=STRING)?                           // [D4]
  ('response' response=STRING)?                                 // [D4]
  ('verified_by' checks+=[Analysis][','])?                      // [D4] analyses of the model
  ('not_verifiable' missing=STRING)?                            // [D4] what the language lacks
  workloads*=Workload
  faults*=Fault
  vary=Vary?
  measures*=Measure
  ('run' duration=NUMBER 'warmup' warmup=NUMBER 'replications' replications=INT)?
;

// [L5] Poisson arrivals that follow the path. [D4] 'compact n': while a store holds the
// jobs of this workload, only the last n are kept (compaction of Delivery 2); the
// others are superseded, not lost.
Workload:
  'workload' name=ID 'rate' rate=NUMBER ('compact' compact=INT)? ':' path+=[Component|Ident]['->']
;

Fault: 'fault' target=[Component|Ident] 'down' 'at' start=NUMBER 'for' length=NUMBER;

Vary: 'vary' target=[Varied|Ident] ':' values+=NUMBER[','];

Varied: Workload | Component;

// [L5] Response measure. [D4] 'recovery' with a workload measures that workload alone,
// at its last component; without one, the slowest workload that the fault holds.
Measure:
  'measure' metric=MeasureMetric (workload=[Workload])? '<=' threshold=NUMBER unit=Unit
;

// [D4] A tactic or pattern, linked to the scenarios that motivate it and to the
// elements it introduces or changes.
Tactic:
  'tactic' name=ID label=STRING
  'for' scenarios+=[Scenario][',']
  ('introduces' introduces+=[Element|Ident][','])?
  ('changes' changes+=[Element|Ident][','])?
;

MeasureMetric: 'p99_latency' | 'lost' | 'recovery';
Unit: 'ms' | 's' | 'events';

Tier: 'T1' | 'T2' | 'T3' | 'T4' | 'T5';
Kind: 'hardware_software' | 'hardware' | 'software' | 'physical';
Nature: 'data_flow' | 'control_command' | 'dependency' | 'event_notification';
Coupling: 'blocking' | 'supply' | 'sink';
Metric: 'availability' | 'latency' | 'deadline' | 'recovery'    // [D] deadline, recovery
      | 'utilization'                                           // [A] load / (capacity x instances)
      | 'detection' | 'drain';                                  // [C] silence detection, buffer drain

// [A] Identifiers of Deliveries 1 and 2 (T2.1, A-K70, A-K85'): letters, digits and '_',
// with '.' or '-' inside and an optional prime. Every ID of the base language is an Ident.
Ident: /[A-Za-z][A-Za-z0-9_]*([.\-][A-Za-z0-9_]+)*'?/;

Comment:
  /\/\/.*$/
;
