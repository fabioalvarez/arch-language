// ILL-FORMED: a workload that skips the balancer of Carga (BUS -> CAR has no connector); C12 rejects it
system NCS

constituent CPS "Sistema de Gestión de Puertos del Caribe" owner "Operadores portuarios de la costa Caribe"
constituent PPS "Sistema de Gestión de Puertos del Pacífico" owner "Operadores portuarios de la costa Pacífica"
constituent RTS "Sistema de Transporte Carretero" owner "Empresas transportadoras y operadores de flotas"
constituent RLS "Sistema de Transporte Férreo" owner "Concesionarios férreos"
constituent FTS "Sistema de Transporte Fluvial" owner "Operadores de navegación fluvial"
constituent NCS "Sistema de Coordinación Nacional" owner "Autoridad nacional (transporte, aduanas y control)"

// T1
component CCC "Consola del Centro de Coordinación" in NCS tier T1 kind software
component CAD "Consola Aduanera" in NCS tier T1 kind software domain Aduana
component APP "Aplicación del Inspector" in NCS tier T1 kind software domain Aduana
// T2
component NCG "National Coordination Gateway" in NCS tier T2 kind software domain Integracion availability 99.9 latency 230000 instances 2
component TRA "Traductor de Mensajes Externos" in NCS tier T2 kind software domain Integracion availability 99.9 instances 2
component BUS "Bus de Eventos" in NCS tier T2 kind software domain Integracion
component ADP "Adaptador de Escáneres" in NCS tier T2 kind software domain Aduana
component BEN "Balanceador de Entrada" in NCS tier T2 kind software domain Integracion availability 99.9
component BTR "Balanceador del Traductor" in NCS tier T2 kind software domain Integracion availability 99.9
component BAD "Balanceador de Aduana" in NCS tier T2 kind software domain Aduana availability 99.9
component BRI "Balanceador de Riesgo" in NCS tier T2 kind software domain Aduana availability 99.9
component BCA "Balanceador de Carga" in NCS tier T2 kind software domain Carga
component BTS "Balanceador de Tránsito" in NCS tier T2 kind software domain Transito
component BUF "Búfer de Eventos" in NCS tier T2 kind software domain Integracion
// T2 — boundary components of the other constituents (as in sos.arch)
component CGW "Caribbean Port Gateway" in CPS tier T2 kind software latency 300000
component PGW "Pacific Port Gateway" in PPS tier T2 kind software
component RGW "Road Gateway" in RTS tier T2 kind software latency 200000 capacity 10000 store
component LGW "Rail Gateway" in RLS tier T2 kind software
component FGW "Fluvial Gateway" in FTS tier T2 kind software
// T3
component CAR "Servicio de Carga" in NCS tier T3 kind software domain Carga availability 99.9 event_capacity 4.5 event_load 1.5 instances 2
component TRS "Servicio de Tránsito" in NCS tier T3 kind software domain Transito event_capacity 60 event_load 20 instances 2
component ADU "Servicio de Aduana" in NCS tier T3 kind software domain Aduana availability 99.9 instances 2
component RSK "Servicio de Riesgo" in NCS tier T3 kind software domain Aduana availability 99.9 instances 2
component IDN "Servicio de Identidad" in NCS tier T3 kind software domain Integracion
component CES "Controlador de Escalamiento" in NCS tier T3 kind software domain Plataforma
// T4
component HCDB "Historial de Carga DB" in NCS tier T4 kind software domain Carga
component RMDB "Repositorio de Manifiestos DB" in NCS tier T4 kind software domain Carga availability 99.9
component HPDB "Historial de Posiciones DB" in NCS tier T4 kind software domain Transito
component EXDB "Expediente Aduanero DB" in NCS tier T4 kind software domain Aduana availability 99.9
component CMDB "Copia de Manifiestos DB" in NCS tier T4 kind software domain Aduana
component RADB "Registro de Auditoría DB" in NCS tier T4 kind software domain Integracion
component EXDB2 "Expediente Aduanero DB (respaldo)" in NCS tier T4 kind software domain Aduana availability 99.9
component HCDBR "Historial de Carga DB (réplica de lectura)" in NCS tier T4 kind software domain Carga
component HPDBR "Historial de Posiciones DB (réplica de lectura)" in NCS tier T4 kind software domain Transito
// T5
component SCN "Escáner de Inspección No Intrusiva" in NCS tier T5 kind physical domain Aduana

// Internal connectors
connector D_K1 nature data_flow coupling blocking
  carries "Mensajes entrantes validados contra el CDM, con identidad del remitente"
  : NCG -> BTR -> TRA
connector D_K2 nature data_flow coupling blocking
  carries "Respuestas en CDM: certificados de levante y estados consolidados"
  : TRA -> NCG
connector D_K3 nature event_notification coupling sink
  carries "Hechos operacionales: arribos, manifiestos, custodias, posiciones"
  : TRA -> BUF
connector D_K4a nature dependency coupling blocking
  carries "Solicitud de trámite de levante"
  : TRA -> BAD -> ADU
connector D_K4b nature data_flow coupling blocking
  carries "Resultado y certificado de levante"
  : ADU -> TRA
connector D_K5a nature dependency coupling blocking
  carries "Consulta de estado, con el constituyente solicitante"
  : TRA -> BCA -> CAR
connector D_K5b nature data_flow coupling blocking
  carries "Estado de la carga, solo si el solicitante participa en ella"
  : CAR -> TRA
connector D_K6 nature event_notification coupling sink
  carries "Arribos, manifiestos, custodias y decisiones de levante"
  : BUS -> BCA -> CAR
connector D_K7 nature dependency coupling blocking
  carries "Escrituras y verificación de duplicados; las lecturas van por D-K37"
  : CAR -> HCDB
connector D_K8 nature dependency coupling blocking
  carries "Lectura y escritura de manifiestos"
  : CAR -> RMDB
connector D_K9 nature event_notification coupling supply
  carries "Posiciones, estado de tránsito y eventos de viaje"
  : BUS -> BTS -> TRS
connector D_K10 nature dependency coupling blocking
  carries "Escrituras y lectura del estado anterior; las lecturas de consultas van por D-K39"
  : TRS -> HPDB
connector D_K11 nature event_notification coupling sink
  carries "Alertas por desvío, detención prolongada o sello comprometido"
  : TRS -> BUS
connector D_K12a nature dependency coupling blocking
  carries "Consulta de la última posición del vehículo que lleva una carga"
  : CAR -> BTS -> TRS
connector D_K12b nature data_flow coupling blocking
  carries "Última posición registrada"
  : TRS -> CAR
connector D_K13 nature event_notification coupling sink
  carries "Alertas operacionales y de tránsito"
  : NCG -> CCC
connector D_K14a nature dependency coupling blocking
  carries "Consulta del historial y estado de una carga"
  : CCC -> BEN -> NCG
connector D_K14b nature data_flow coupling blocking
  carries "Historia completa y estado consolidado"
  : NCG -> CCC
connector D_K15a nature dependency coupling blocking
  carries "Solicitud de evaluación de riesgo"
  : ADU -> BRI -> RSK
connector D_K15b nature data_flow coupling blocking
  carries "Perfil de riesgo calculado y control sugerido"
  : RSK -> ADU
connector D_K16a nature dependency coupling blocking
  carries "Solicitud de manifiesto, solo si a la Copia de Manifiestos DB le falta o no está disponible"
  : RSK -> BCA -> CAR
connector D_K16b nature data_flow coupling blocking
  carries "Manifiesto y actores involucrados"
  : CAR -> RSK
connector D_K17 nature dependency coupling blocking
  carries "Lectura de antecedentes, sanciones e historial de inspecciones"
  : RSK -> EXDB
connector D_K18a nature dependency coupling blocking
  carries "Consulta de los casos pendientes de revisión"
  : CAD -> BEN -> NCG
connector D_K18b nature data_flow coupling blocking
  carries "Casos pendientes, con su evaluación de riesgo y antecedentes"
  : NCG -> CAD
connector D_K19 nature control_command coupling blocking
  carries "Decisión del funcionario: levante, escáner o inspección física"
  : CAD -> BEN -> NCG
connector D_K20 nature dependency coupling blocking
  carries "Lectura y escritura del expediente"
  : ADU -> EXDB
connector D_K21 nature control_command coupling blocking
  carries "Orden de inspección no intrusiva"
  : ADU -> ADP
connector D_K22 nature control_command coupling blocking
  carries "Instrucción en el protocolo del fabricante"
  : NCG -> SCN
connector D_K23 nature data_flow coupling blocking
  carries "Imagen y lectura técnica"
  : SCN -> BEN -> NCG
connector D_K24 nature data_flow coupling blocking
  carries "Resultado estandarizado de la inspección, y aviso de falla o de plazo vencido del escáner"
  : ADP -> BAD -> ADU
connector D_K25a nature dependency coupling blocking
  carries "Consulta de las órdenes de inspección física asignadas"
  : APP -> BEN -> NCG
connector D_K25b nature data_flow coupling blocking
  carries "Órdenes de inspección física asignadas"
  : NCG -> APP
connector D_K26 nature data_flow coupling blocking
  carries "Hallazgos y verificación del sello"
  : APP -> BEN -> NCG
connector D_K27 nature event_notification coupling sink
  carries "Decisión de levante emitida"
  : ADU -> BUF

