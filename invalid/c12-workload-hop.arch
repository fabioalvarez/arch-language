// Analyses (Delivery 2, section 8: resulting structure)
analysis DQS1 scenario "D-QS1" availability target 99.9 :
  NCG beta 0.10, TRA beta 0.10, ADU beta 0.10, RSK beta 0.10, [EXDB | EXDB2] beta 0.10
// Same chain with the load balancers it traverses, at the availability of L17 (99.9 %)
analysis DQS1Balancers scenario "D-QS1 (with balancers)" availability target 99.9 :
  BEN, NCG beta 0.10, BTR, TRA beta 0.10, BAD, ADU beta 0.10, BRI, RSK beta 0.10, [EXDB | EXDB2] beta 0.10
// Backlog after compaction (Delivery 2): 14400 custody events, consumed only by CAR,
// and 6000 compacted position reports, consumed only by TRS.
analysis DQS10 scenario "D-QS10" recovery backlog 20400 target 230 :
  CAR = 14400, TRS = 6000

// Analyses of SoS-QS1 (section 3.6.6 of Delivery 2): composition of the agreed budgets
analysis SoSQS1M4 scenario "SoS-QS1 (M4)" deadline target 900 :
  RGW = 200, SoS_K5 = 40, NCG = 230, SoS_K32 = 10,
  [CGW = 300 | PGW = 300 | LGW = 300 | FGW = 300]
analysis SoSQS1M3 scenario "SoS-QS1 (M3)" deadline target 60 :
  RGW = 30, SoS_K36 = 10, NCG = 15

// Scenarios for verification (Delivery 4). Six parts reconstructed from Delivery 3
// [PENDIENTE: confirmar con la Entrega 2].
scenario QS_D1 "D-QS1" attribute "disponibilidad"
  source "Falla interna de un elemento del NCS (hardware o software)"
  stimulus "Un elemento de la cadena de levante deja de responder"
  artifact NCG, TRA, ADU, RSK, EXDB, EXDB2
  environment "Operación normal, con solicitudes de levante de los puertos"
  response "La cadena sigue decidiendo levantes; la falla se enmascara con réplicas"
  verified_by DQS1, DQS1Balancers

// D-QS10: Carretera cae 4 h (14 400 s) y al volver reenvía lo que retuvo. RGW (la salida de
// Carretera) es un store: retiene lo que recibe mientras está caído. Su capacidad de
// reenvío es un parámetro de otro dueño (supuesto: 10 000 eventos/s, reenvío casi
// inmediato), así que la recuperación medida es la del NCS. Custodias (1/s) solo las
// consume CAR; posiciones (20/s) solo TRS; CAR recibe además 0,5 eventos/s de carga
// propia de los puertos (event_load 1,5).
scenario QS_D10 "D-QS10" attribute "recuperabilidad"
  source "Sistema de Transporte Carretero (RTS), al recuperarse de una caída"
  stimulus "Reenvío de las custodias y posiciones retenidas durante 4 h"
  artifact NCG, BUS, CAR, TRS
  environment "Recuperación tras la caída de Carretera, con la carga normal en curso"
  response "El NCS consolida el rezago y vuelve a dar estado al día"
  verified_by DQS10
  workload Custody rate 1 : RGW -> BEN -> NCG -> BTR -> TRA -> BUF -> BUS -> CAR
  workload Positions rate 20 compact 6000 : RGW -> BEN -> NCG -> BTR -> TRA -> BUF -> BUS -> BTS -> TRS
  workload OtherCargo rate 0.5 : TRA -> BUF -> BUS -> BCA -> CAR
  fault RGW down at 0 for 14400
  measure recovery Custody <= 230 s
  measure recovery Positions <= 230 s
  measure recovery <= 230 s
  measure lost Custody <= 0 events
  run 17000 warmup 0 replications 10

